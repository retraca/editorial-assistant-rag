# Azure OpenAI.
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5.1-chat
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-12-01-preview

# Retrieval tuning. Defaults are the values justified in DECISIONS.md.
EMBEDDING_DIMS=1024
CHUNK_TARGET_WORDS=350
CHUNK_OVERLAP_WORDS=60
RETRIEVAL_K=8
# Pull the chunks either side of the top N hits. This is what actually solves the
# boundary problem that chunk overlap was supposed to solve: overlap heals 11 of
# 30 test seams, neighbours heal 30 of 30. Boundary set 24/30 -> 30/30, held-out
# strict recall 75.0% -> 81.7%, answer eval 8/10 -> 9/10. 0 disables. See D-68.
RETRIEVAL_NEIGHBOURS=2
RRF_K=10
# Second-stage reranking. ON by default: +8.3pp chapter recall on the held-out
# set, 95% CI [1.7, 16.7]. Costs ~$0.0065 and ~4.8s per query. Set false to
# roughly halve latency and cost at a measured quality loss.
RERANK=true
# Per-claim verification after generation (D-61). One extra model call per answer,
# about $0.004 and no measurable added latency. Checks each sentence against every
# passage retrieved, and reports the ones carrying information no passage contains.
# Measured: 6 flags across 193 claims, agreeing with the groundedness judge where
# it fires. Set false to save the call.
CLAIM_CHECK=true

# Weight given to character-alias expansions in the lexical arm (Lizzy->Elizabeth).
# 0 disables. 0.3 chosen by sweep: best gain on alias queries, least cost elsewhere.
ALIAS_WEIGHT=0.3
# Multi-hop entity follow-up: chase rare names found IN results but absent from
# the query. Fixes multi-needle 3/4 -> 4/4 at ~20% more cost, with no measured
# answer-quality cost once the answer eval was made reliable. See D-31.
ENTITY_EXPANSION=true
EXPAND_MIN_IDF=5.0

# Cost accounting. ASSUMED rates in USD per 1M tokens. The sandbox does not
# publish pricing for this deployment, so these are estimates used to make cost
# *visible and relative*, not billing-accurate. See DECISIONS.md.
PRICE_LLM_INPUT_PER_M=1.25
PRICE_LLM_OUTPUT_PER_M=10.00
PRICE_EMBEDDING_PER_M=0.13
# Multiplier for prompt tokens served from the provider's prefix cache.
# 0.25 is the common industry rate; ASSUMED, like the rates above.
PRICE_CACHED_INPUT_MULTIPLIER=0.25

# Reranking reads this many characters of each candidate. 700 was swept (D-69):
# 350 costs 5 percentage points of recall, 1200 buys nothing back.
RERANK_CHARS=700
# Characters of each passage shown to the claim auditor. 0 means the whole
# passage, which is what ships. See D-61.
CLAIM_PASSAGE_CHARS=0
# Prefix each chunk with its book and chapter before embedding. The cheap form
# of contextual retrieval, tested and rejected: it made retrieval worse. See D-21.
CONTEXT_PREFIX=false
# Have a model classify each cross-book similarity pair in words rather than
# showing a raw score. Turning it off leaves the reader a number they cannot act
# on, which D-33 forbids. On unless you are profiling.
SIMILARITY_JUDGE=true

PORT=8080

# ---------------------------------------------------------------------------
# Public demo. Every value here is optional and everything is inert when unset,
# so a local run behaves exactly as it does without this block.
# ---------------------------------------------------------------------------

# Which API the same two models are reached through: azure (default) or openai.
# Either reaches the same two models. text-embedding-3-large at 1024 dims either way, so
# the shipped index is reused rather than rebuilt.
LLM_PROVIDER=azure
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5.1-chat-latest
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Shared password for the demo. Empty means no gate, which is correct locally
# and wrong on a public URL.
DEMO_PASSWORD=

# Questions per visitor per hour. 0 means no ceiling.
DEMO_QUESTIONS_PER_HOUR=0

# SQLite file for threads, ratings, usage and flagged answers. Empty means no
# database and no persistence beyond the browser.
DEMO_DB_PATH=

{
  "name": "editorial-assistant-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "tsx src/ingest/build-index.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "eval": "tsx src/eval/run.ts",
    "eval:generate": "tsx src/eval/generate.ts",
    "eval:hard": "tsx src/eval/run-generated.ts",
    "eval:compare": "tsx src/eval/compare.ts",
    "eval:niah": "tsx src/eval/niah.ts",
    "summarise": "tsx src/ingest/summarise.ts",
    "test": "tsx --test src/test/*.test.ts",
    "eval:boundary": "tsx src/eval/boundary.ts",
    "eval:tamper": "tsx src/eval/tamper.ts",
    "eval:notes": "tsx src/eval/notes.ts",
    "eval:quality": "tsx src/eval/quality.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
